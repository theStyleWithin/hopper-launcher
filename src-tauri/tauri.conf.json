{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hopper Launcher",
  "version": "0.1.0",
  "identifier": "com.gamehopper.launcher",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Hopper Launcher",
        "width": 1000,
        "height": 680,
        "minWidth": 720,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage", "deb"],
    "icon": ["icons/icon.png", "icons/icon.ico"]
  }
}
