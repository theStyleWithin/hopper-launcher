<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Lets the launcher hand a downloaded APK to Android's installer. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Lets it see whether the apps it installed are still on the phone. -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />

    <application>
        <provider
            android:name="com.gamehopper.launcher.hopper.HopperFileProvider"
            android:authorities="${applicationId}.hopper.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/hopper_file_paths" />
        </provider>
    </application>
</manifest>
